# Nusxa: cp .env.example .env
# Keyin `npm run build` qiling. NEXT_PUBLIC_ qiymati build vaqtida kodga yoziladi.
# Serverda keyin .env ni o'zgartirish yetmaydi — qayta build kerak.
#
# Oxirida slash bo'lsin. Axios `auth/login` ni shu bazaga ulaydi.
# Domen o'zgarsa shu qatorni va keyin `npm run build` ni qaytaring.

NEXT_PUBLIC_BASE_API_URL=https://cowork.jdu.uz/api/v1/

# Secretlarni NEXT_PUBLIC_ ga qo'ymang. Ular brauzer bundle ga tushadi.
